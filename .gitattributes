# Auto-detect text files and normalize to LF in the repository
* text=auto

# Source code — explicitly LF, even on Windows
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.prisma text eol=lf

# Shell scripts — must stay LF
*.sh     text eol=lf
*.bash   text eol=lf

# Batch files — must stay CRLF on Windows
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary files — never touch
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    binary
*.woff   binary
*.woff2  binary
*.eot    binary
*.ttf    binary
*.otf    binary
*.zip    binary
*.tar    binary
*.gz     binary
*.pdf    binary
